{
  "name": "leadflow-backend",
  "version": "1.0.0",
  "description": "Leadflow B2B Prospecting SaaS - Backend API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "sanitize:google-maps": "tsx scripts/sanitize-google-maps-leads.ts",
    "sanitize:scraping": "tsx scripts/sanitize-scraping-leads.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "leadflow",
    "b2b",
    "prospecting",
    "saas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/multipart": "^8.1.0",
    "@prisma/client": "^5.9.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.1.8",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "handlebars": "^4.7.8",
    "imapflow": "^1.0.185",
    "ioredis": "^5.3.2",
    "mailparser": "^3.6.9",
    "nodemailer": "^6.9.11",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "prisma": "^5.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
