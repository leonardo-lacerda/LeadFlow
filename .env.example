NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
REDIS_PORT=6379
BACKEND_BIND_IP=127.0.0.1
EVOLUTION_BIND_IP=127.0.0.1
API_PROXY_DOMAIN=api.lastreia.app
ACME_EMAIL=security@lastreia.app

POSTGRES_DB=lastreia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password

JWT_SECRET=replace_with_strong_jwt_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
SECRETS_ENCRYPTION_KEY=replace_with_strong_encryption_key

EVOLUTION_API_KEY=replace_with_strong_evolution_api_key

SCRAPING_WEBHOOK_SECRET=replace_with_strong_scraping_webhook_secret
ENRICHMENT_WEBHOOK_SECRET=replace_with_strong_enrichment_webhook_secret
AI_WEBHOOK_SECRET=replace_with_strong_ai_webhook_secret
WHATSAPP_WEBHOOK_SECRET=replace_with_strong_whatsapp_webhook_secret
EMAIL_WEBHOOK_SECRET=replace_with_strong_email_webhook_secret
EMAIL_TRACKING_SIGNING_SECRET=replace_with_strong_tracking_secret
EMAIL_TRACKING_ALLOWED_DOMAINS=
WEBHOOK_URL_ALLOWLIST=

RUN_WORKERS=true
RUN_IMAP_POLLING=true
INTERNAL_REQUEST_TIMEOUT_MS=30000

SCRAPING_NO_API=true
AUTO_ENRICH_LEADS=false

SCRAPING_MOCK=false
ALLOW_SCRAPING_MOCK_IN_PRODUCTION=false
ENRICHMENT_MOCK=true
ALLOW_ENRICHMENT_MOCK_IN_PRODUCTION=false
AI_MOCK=true
ALLOW_AI_MOCK_IN_PRODUCTION=false
ALLOW_MOCK_SCRAPING_LEADS_IN_PRODUCTION=false

CNPJ_WS_BASE_URL=
SERPAPI_KEY=
WAPPALYZER_API_KEY=
PROXY_LIST=

HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
ZEROBOUNCE_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

OAUTH_STATE_TTL_SECONDS=900
OAUTH_STATE_PREFIX=oauth:state

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:4000/api/integrations/twitter/oauth/callback
TWITTER_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/integrations/linkedin/oauth/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
